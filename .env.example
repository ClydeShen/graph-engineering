# Database (Docker PostgreSQL)
# Dev runtime uses its own DB; integration tests use TEST_DATABASE_URL so a
# `npm test` run never pollutes the data you see in the Console.
DATABASE_URL=postgres://postgres:password@localhost:5432/graph
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/graph_test

# iii Engine WebSocket
III_URL=ws://localhost:4001

# HTTP Gateway port
PORT=4000

# Log level (debug for Gate 1 — full hash chain visibility)
LOG_LEVEL=debug

# LLM Provider (Gate 1: placeholder values, no real LLM calls)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
LLM_API_KEY=placeholder

# Telegram channel
TELEGRAM_BOT_TOKEN=
# Edge allowlist: comma-separated chat IDs allowed to drive the agent. Empty =
# allow ALL (the bot logs a startup warning). '*' = explicitly allow all and
# silence the warning. Unlisted chats are dropped before reaching the agent.
TELEGRAM_ALLOWED_CHATS=
# Webhook mode only: shared secret echoed back by Telegram in
# X-Telegram-Bot-Api-Secret-Token; forged webhook POSTs without it are rejected.
TELEGRAM_WEBHOOK_SECRET=
