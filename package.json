{
  "name": "graph-native-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test:unit": "vitest run src/__tests__",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run",
    "test:db": "node scripts/test-with-db.mjs",
    "eval:loop": "tsx scripts/eval/loop-gate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d && npx tsx scripts/migrate.ts",
    "demo": "tsx scripts/demo-runner.ts",
    "analyze-feedback": "tsx scripts/analyze-feedback.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@dqbd/tiktoken": "1.0.22",
    "@hono/zod-validator": "0.8.0",
    "hono": "4.12.23",
    "iii-sdk": "0.17.0",
    "pg": "8.21.0",
    "pg-listen": "1.7.0",
    "pino": "9.6.0",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/three": "^0.184.1",
    "husky": "^9.1.7",
    "tsx": "4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2"
  }
}
