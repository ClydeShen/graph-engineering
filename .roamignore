# Roam ignore — gitignore syntax.

# ── Vendored deps ──────────────────────────────────────────────
node_modules/

# ── Roam internal state (circular) ────────────────────────────
.roam/

# ── Agent tooling state (no code signal) ──────────────────────
# Session state, phase plans, research notes, memory — operational
# artifacts for the harness/agent, not runtime source code.
.harness/
.planning/
.memobank/
.claude/

# ── CI / platform config ──────────────────────────────────────
.github/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
out/

# ── Lock files ────────────────────────────────────────────────
package-lock.json

# ── Env / secrets ─────────────────────────────────────────────
.env
.env.*
